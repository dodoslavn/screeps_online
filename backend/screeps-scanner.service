[Unit]
Description=Screeps Server Scanner
After=network.target mysql.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/home/dodanek/screeps_online/backend
ExecStart=/usr/bin/php /home/dodanek/screeps_online/backend/scan.php

# Use journald for logging (simpler than file logging)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=screeps-scanner

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
